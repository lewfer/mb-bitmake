<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="lI_(BI2@P9yeK_1Q)^%A" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="=`%:Qe/I]u(uMx([p5iG"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace bitmake {" line1="    /* Button" line2="       ----------------------------------------------------" line3="    */" line4="    export class Button {" line5="        pin: DigitalPin;" line6="" line7="        //% blockId=Button_pressed" line8="        //% block=&quot;%button|pressed&quot;" line9="        //% weight=50" line10="        //% group=&quot;Button&quot;" line11="        pressed() {" line12="            return pins.digitalReadPin(this.pin) == 0" line13="        }" line14="" line15="        //% blockId=Button_notPressed" line16="        //% block=&quot;%button|not pressed&quot;" line17="        //% weight=50" line18="        //% group=&quot;Button&quot;" line19="        notPressed() {" line20="            return pins.digitalReadPin(this.pin) == 1" line21="        }" line22="" line23="        //% blockId=Button_waitForPress" line24="        //% block=&quot;%button|wait for press&quot;" line25="        //% weight=50" line26="        //% group=&quot;Button&quot;" line27="        waitForPress() {" line28="            while (pins.digitalReadPin(this.pin) != 0)" line29="                basic.pause(100)" line30="        }" line31="" line32="        //% blockId=Button_waitForRelease" line33="        //% block=&quot;%button|wait for release&quot;" line34="        //% weight=50" line35="        //% group=&quot;Button&quot;" line36="        waitForRelease() {" line37="            while (pins.digitalReadPin(this.pin) == 0)" line38="                basic.pause(100)" line39="        }" line40="    }" line41="" line42="    //% blockId=&quot;Button_create&quot;" line43="    //% block=&quot;Button at pin %pin&quot;" line44="    //% weight=50" line45="    //% group=&quot;Button&quot;" line46="    //% blockSetVariable=button" line47="    export function createButton(pin: DigitalPin): Button {" line48="        let button = new Button();" line49="        button.pin = pin" line50="        pins.setPull(pin, PinPullMode.PullUp)" line51="        return button;" line52="    }" line53="" line54="" line55="    /* Led" line56="       ----------------------------------------------------" line57="    */" line58="    export class Led {" line59="        pin: DigitalPin;" line60="        status: number" line61="" line62="        //% blockId=&quot;Led_on&quot;    " line63="        //% block=&quot;%led|on&quot;" line64="        //% weight=50" line65="        //% group=&quot;Led&quot;" line66="        on(): void {" line67="            this.status = 1" line68="            pins.digitalWritePin(this.pin, this.status)" line69="        }" line70="" line71="        //% blockId=&quot;Led_off&quot;" line72="        //% block=&quot;%led|off&quot;" line73="        //% weight=50" line74="        //% group=&quot;Led&quot;" line75="        off(): void {" line76="            this.status = 0" line77="            pins.digitalWritePin(this.pin, this.status)" line78="        }" line79="" line80="        //% blockId=&quot;Led_toggle&quot;" line81="        //% block=&quot;%led|toggle&quot;" line82="        //% weight=50" line83="        //% group=&quot;Led&quot;" line84="        toggle(): void {" line85="            this.status = 1 - this.status" line86="            pins.digitalWritePin(this.pin, this.status)" line87="        }" line88="    }" line89="" line90="    //% blockId=&quot;Led_create&quot;" line91="    //% block=&quot;Led at pin %pin&quot;" line92="    //% weight=50" line93="    //% group=&quot;Led&quot;" line94="    //% blockSetVariable=led" line95="    export function createLed(pin: DigitalPin): Led {" line96="        let led = new Led();" line97="        led.pin = pin" line98="        return led;" line99="    }" line100="" line101="" line102="    /* DimmableLed" line103="       ----------------------------------------------------" line104="    */" line105="    export class DimmableLed {" line106="        pin: AnalogPin;" line107="        value: number" line108="        rangeFrom: number;" line109="        rangeTo: number" line110="" line111="        private scale() : number {" line112="            return Math.map(this.value, this.rangeFrom, this.rangeTo, 0, 1023)" line113="        }" line114="" line115="        private unScale(): number {" line116="            return Math.map(this.value, 0, 1023, this.rangeFrom, this.rangeTo)" line117="        }" line118="" line119="        //% blockId=&quot;DimmableLed_on&quot;" line120="        //% block=&quot;%led|on&quot;" line121="        //% weight=50" line122="        //% group=&quot;Dimmable Led&quot;" line123="        on(): void {" line124="            this.value = this.rangeTo" line125="            pins.analogWritePin(this.pin, 1023)" line126="        }" line127="" line128="        //% blockId=&quot;DimmableLed_off&quot;" line129="        //% block=&quot;%led|off&quot;" line130="        //% weight=50" line131="        //% group=&quot;Dimmable Led&quot;" line132="        off(): void {" line133="            this.value = this.rangeFrom" line134="            pins.analogWritePin(this.pin, 0)" line135="        }" line136="" line137="        //% blockId=&quot;DimmableLed_setIntensity&quot;" line138="        //% block=&quot;%led|intensity %value&quot;" line139="        //% weight=50" line140="        //% group=&quot;Dimmable Led&quot;" line141="        setIntensity(value: number): void {" line142="            this.value = value" line143="            pins.analogWritePin(this.pin, this.scale())" line144="        }" line145="" line146="" line147="        //% blockId=&quot;DimmableLed_toggle&quot;" line148="        //% block=&quot;%led|toggle&quot;" line149="        //% weight=50" line150="        //% group=&quot;Dimmable Led&quot;" line151="        toggle(): void {" line152="            this.value = this.rangeTo - this.value + this.rangeFrom" line153="            pins.analogWritePin(this.pin, this.scale())" line154="        }" line155="    }" line156="" line157="    //% blockId=&quot;DimmableLed_create&quot;" line158="    //% block=&quot;DimmableLed at pin %pin from $rangeFrom to $rangeTo&quot;" line159="    //% weight=50" line160="    //% group=&quot;Dimmable Led&quot;" line161="    //% blockSetVariable=led" line162="    //% rangeFrom.defl=0" line163="    //% rangeTo.defl=100" line164="    export function createDimmableLed(pin: AnalogPin, rangeFrom: number=0, rangeTo: number=100): DimmableLed {" line165="        let led2 = new DimmableLed();" line166="        led2.pin = pin" line167="        led2.rangeFrom = rangeFrom;" line168="        led2.rangeTo = rangeTo;" line169="        return led2;" line170="    }" line171="" line172="   " line173="" line174="    /* AnalogInput" line175="       ----------------------------------------------------" line176="    */" line177="    export class AnalogInput {" line178="        pin: AnalogPin;" line179="        rangeFrom: number;" line180="        rangeTo: number" line181="" line182="        //% blockId=&quot;AnalogInput_value&quot;" line183="        //% block=&quot;%analog|value&quot;" line184="        //% weight=50" line185="        //% group=&quot;AnalogInput&quot;" line186="        value(): number {" line187="            let val = pins.analogReadPin(this.pin)" line188="            return Math.map(val, 0, 1023, this.rangeFrom, this.rangeTo)" line189="        }" line190="    }" line191="" line192="    //% blockId=&quot;AnalogInput_create&quot;" line193="    //% block=&quot;AnalogInput at pin %pin from %rangeFrom to %rangeTo&quot;" line194="    //% weight=50" line195="    //% group=&quot;AnalogInput&quot;" line196="    //% blockSetVariable=analog" line197="    //% rangeFrom.defl=0" line198="    //% rangeTo.defl=100" line199="    export function createAnalogInput(pin: AnalogPin, rangeFrom: number=0, rangeTo: number=100): AnalogInput {" line200="        let anIn = new AnalogInput();" line201="        anIn.pin = pin" line202="        anIn.rangeFrom = rangeFrom;" line203="        anIn.rangeTo = rangeTo;" line204="        return anIn;" line205="    }" line206="}" numlines="207"></mutation></block></statement></block></xml>